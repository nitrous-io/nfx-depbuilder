{
  "AWSTemplateFormatVersion": "2010-09-09",

  "Mappings": {
    "DefaultAmiForRegion": {
      "us-east-1": { "id": "ami-3d55272a" },
      "us-west-1": { "id": "ami-444d0224" },
      "us-west-2": { "id": "ami-1ccd1f7c" },
      "eu-west-1": { "id": "ami-b6760fc5" },
      "eu-central-1": { "id": "ami-f562909a" },
      "ap-northeast-1": { "id": "ami-096cba68" },
      "ap-southeast-1": { "id": "ami-7934ee1a" },
      "ap-southeast-2": { "id": "ami-22a49541" }
    }
  },

  "Parameters": {
    "EcsAmiId": {
      "Type": "String",
      "Description": "AMI ID for use in ECS."
    },

    "KeyPair": {
      "Type": "AWS::EC2::KeyPair::KeyName",
      "Description": "EC2 key pair that gets added to EC2 instances in the ECS cluster."
    },

    "NotificationEmail": {
      "Type": "String",
      "Default": "eng@nitrous.io",
      "Description": "Email address where notifications and alarms get sent to."
    }
  },

  "Conditions": {
    "UseDefaultAmi": { "Fn::Equals": [ { "Ref": "EcsAmiId" }, "" ] }
  },

  "Resources": {
    "BuilderDockerRepository": {
      "Type": "AWS::ECR::Repository"
    },

    "WebDockerRepository": {
      "Type": "AWS::ECR::Repository"
    },

    "EmailNotificationTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "Subscription": [{
          "Endpoint": { "Ref": "NotificationEmail" },
          "Protocol": "email"
        }]
      }
    },

    "JobsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Delete"
    },

    "JobQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": "300",
        "RedrivePolicy": {
          "deadLetterTargetArn": { "Fn::GetAtt": [ "JobDeadLetterQueue", "Arn" ] },
          "maxReceiveCount": 3
        }
      }
    },

    "JobDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": "300"
      }
    },

    "JobQueueDepthAlert": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Alarm if queue depth grows beyond 10 messages",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [{
          "Name": "QueueName",
          "Value": { "Fn::GetAtt": ["JobQueue", "QueueName"] }
        }],
        "Statistic": "Sum",
        "Period": "300",
        "EvaluationPeriods": "1",
        "Threshold": "10",
        "ComparisonOperator": "GreaterThanThreshold",
        "AlarmActions": [{ "Ref": "EmailNotificationTopic" }],
        "InsufficientDataActions": [{ "Ref": "EmailNotificationTopic" }]
      }
    },

    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [ { "Key": "Name", "Value": "nfx-vpc-igw" } ]
      }
    },

    "VPC": {
      "Type": "AWS::EC2::VPC",
      "DependsOn": "InternetGateway",
      "Properties": {
        "CidrBlock": "10.0.0.0/16",
        "EnableDnsSupport": "true",
        "EnableDnsHostnames": "true",
        "InstanceTenancy": "default",
        "Tags": [ { "Key": "Name", "Value": "nfx-vpc" } ]
      }
    },

    "AttachInternetGateway": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "InternetGatewayId": { "Ref": "InternetGateway" }
      }
    },

    "BastionHostVPCSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "GroupDescription": "Restricts inbound traffic from the Internet to SSH port.",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": "22",
            "ToPort": "22",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },

    "SSHFromBastionSGIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["VPC", "DefaultSecurityGroup"] },
        "IpProtocol": "tcp",
        "FromPort": "22",
        "ToPort": "22",
        "SourceSecurityGroupId": { "Ref": "BastionHostVPCSecurityGroup" }
      },
      "Metadata": {
        "Comment": "This adds an ingress rule for SSH to the default security group of the VPC."
      }
    },

    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "DependsOn": "PublicRouteTable",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "CidrBlock": "10.0.0.0/24",
        "MapPublicIpOnLaunch": "true",
        "AvailabilityZone": {
          "Fn::Select": [ "0", { "Fn::GetAZs": { "Ref": "AWS::Region" } } ]
        },
        "Tags": [ { "Key": "Name", "Value": "nfx-vpc-public" } ]
      }
    },

    "PublicSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "DependsOn": "PublicRouteTable",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "CidrBlock": "10.0.2.0/24",
        "MapPublicIpOnLaunch": "true",
        "AvailabilityZone": {
          "Fn::Select": [ "1", { "Fn::GetAZs": { "Ref": "AWS::Region" } } ]
        },
        "Tags": [ { "Key": "Name", "Value": "nfx-vpc-public" } ]
      }
    },

    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "Tags": [ { "Key": "Name", "Value": "nfx-vpc-route-table-igw" } ]
      }
    },

    "PublicRouteViaInternetGateway": {
      "DependsOn": "AttachInternetGateway",
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": { "Ref": "PublicRouteTable" },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": { "Ref": "InternetGateway" }
      }
    },

    "PublicSubnetRouteTableAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "PublicSubnet1" },
        "RouteTableId": { "Ref": "PublicRouteTable" }
      }
    },

    "PublicSubnetRouteTableAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "PublicSubnet2" },
        "RouteTableId": { "Ref": "PublicRouteTable" }
      }
    },

    "NATElasticIP": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },

    "NATGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": { "Fn::GetAtt": ["NATElasticIP", "AllocationId"] },
        "SubnetId": { "Ref": "PublicSubnet1" }
      }
    },

    "PrivateRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "Tags": [ { "Key": "Name", "Value": "nfx-vpc-route-table-nat" } ]
      }
    },

    "RouteViaNATGateway": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": { "Ref": "PrivateRouteTable" },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": { "Ref": "NATGateway" }
      }
    },

    "PrivateSubnet": {
      "Type": "AWS::EC2::Subnet",
      "DependsOn": "PrivateRouteTable",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "CidrBlock": "10.0.1.0/24",
        "MapPublicIpOnLaunch": "false",
        "AvailabilityZone": {
          "Fn::Select": [ "0", { "Fn::GetAZs": { "Ref": "AWS::Region" } } ]
        },
        "Tags": [ { "Key": "Name", "Value": "nfx-vpc-private" } ]
      }
    },

    "PrivateSubnetRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "PrivateSubnet" },
        "RouteTableId": { "Ref": "PrivateRouteTable" }
      }
    },

    "ECSCluster": {
      "Type": "AWS::ECS::Cluster",
      "DependsOn": "VPC",
      "Metadata": {
        "Comment": "Specifying a ClusterName property will fail if a _deleted_ cluster of the same name existed previously, so we don't specify it."
      }
    },

    "ECSLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": "30"
      }
    },

    "ECSBuilderServiceTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "DependsOn": "ECSLogGroup",
      "Properties": {
        "ContainerDefinitions": [{
          "Name": "nfx-depbuilder-builder",
          "Cpu": "512",
          "Memory": "960",
          "Essential": "true",
          "Image": {
            "Fn::Join": [ "", [
              { "Ref": "AWS::AccountId" },
              ".dkr.ecr.",
              { "Ref": "AWS::Region" },
              ".amazonaws.com/",
              { "Ref": "BuilderDockerRepository" },
              ":latest"
            ] ]
          },
          "Environment": [
            { "Name": "AWS_REGION", "Value": { "Ref": "AWS::Region" } },
            { "Name": "SQS_QUEUE_URL", "Value": { "Ref": "JobQueue" } },
            { "Name": "RESPONSE_LOG_GROUP", "Value": { "Ref": "ECSLogGroup" } }
          ],
          "LogConfiguration": {
            "LogDriver": "awslogs",
            "Options": {
              "awslogs-region": { "Ref": "AWS::Region" },
              "awslogs-group": { "Ref": "ECSLogGroup"},
              "awslogs-stream-prefix": "builder"
            }
          }
        }],
        "TaskRoleArn": { "Ref": "ECSTaskRole" }
      }
    },

    "ECSBuilderService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": "ECSInstanceAutoScalingGroup",
      "Properties": {
        "Cluster": { "Ref": "ECSCluster" },
        "TaskDefinition": { "Ref": "ECSBuilderServiceTaskDefinition" },
        "DesiredCount": 1
      }
    },

    "ECSWebServiceTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "DependsOn": "ECSLogGroup",
      "Properties": {
        "ContainerDefinitions": [{
          "Name": "nfx-depbuilder-web",
          "Cpu": "512",
          "Memory": "960",
          "Essential": "true",
          "Image": {
            "Fn::Join": [ "", [
              { "Ref": "AWS::AccountId" },
              ".dkr.ecr.",
              { "Ref": "AWS::Region" },
              ".amazonaws.com/",
              { "Ref": "WebDockerRepository" },
              ":latest"
            ] ]
          },
          "Environment": [
            { "Name": "AWS_REGION", "Value": { "Ref": "AWS::Region" } },
            { "Name": "NFX_WEB_S3_BUCKET", "Value": { "Ref": "JobsBucket" } },
            { "Name": "NFX_WEB_TASK_DEF_ARN", "Value": { "Ref": "ECSBuilderServiceTaskDefinition" } },
            { "Name": "NFX_WEB_TASK_CLUSTER_NAME", "Value": { "Ref": "ECSCluster" } },
            { "Name": "NFX_WEB_SQS_QUEUE_URL", "Value": { "Ref": "JobQueue" } },
            { "Name": "NFX_WEB_RESPONSE_LOG_GROUP", "Value": { "Ref": "ECSLogGroup" } }
          ],
          "PortMappings": [
            { "ContainerPort": "3333" }
          ],
          "LogConfiguration": {
            "LogDriver": "awslogs",
            "Options": {
              "awslogs-region": { "Ref": "AWS::Region" },
              "awslogs-group": { "Ref": "ECSLogGroup"},
              "awslogs-stream-prefix": "web"
            }
          }
        }],
        "TaskRoleArn": { "Ref": "ECSTaskRole" }
      }
    },

    "ECSWebService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": "ECSInstanceAutoScalingGroup",
      "Properties": {
        "Cluster": { "Ref": "ECSCluster" },
        "TaskDefinition": { "Ref": "ECSWebServiceTaskDefinition" },
        "DesiredCount": 1,
        "LoadBalancers" : [{
          "TargetGroupArn" : { "Ref" : "ALBTargetGroup" },
          "ContainerPort" : "3333",
          "ContainerName" : "nfx-depbuilder-web"
        }],
        "Role" : { "Ref":"ECSWebServiceRole" }
      }
    },

    "ECSWebServiceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ecs.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Path": "/",
        "Policies": [
          {
            "PolicyName": "ecs-service",
            "PolicyDocument": {
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:AuthorizeSecurityGroupIngress",
                    "ec2:Describe*",
                    "elasticloadbalancing:DeregisterInstancesFromLoadBalancer",
                    "elasticloadbalancing:Describe*",
                    "elasticloadbalancing:RegisterInstancesWithLoadBalancer",
                    "elasticloadbalancing:DeregisterTargets",
                    "elasticloadbalancing:RegisterTargets"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },

    "ECSInstanceLaunchConfig": {
      "Type": "AWS::AutoScaling::LaunchConfiguration",
      "Properties": {
        "ImageId": {
          "Fn::If": [
            "UseDefaultAmi",
            { "Fn::FindInMap": [ "DefaultAmiForRegion", { "Ref": "AWS::Region" }, "id" ] },
            { "Ref": "EcsAmiId" }
          ]
        },
        "InstanceType": "t2.small",
        "KeyName": { "Ref": "KeyPair" },
        "IamInstanceProfile": { "Ref": "ECSInstanceProfile" },
        "SecurityGroups": [{ "Fn::GetAtt": ["VPC", "DefaultSecurityGroup"] }],
        "AssociatePublicIpAddress": "false",
        "InstanceMonitoring": "true",
        "UserData": { "Fn::Base64": { "Fn::Join": ["", [
          "#!/bin/bash\n",
          "echo ECS_CLUSTER=", { "Ref": "ECSCluster" }, " >> /etc/ecs/ecs.config"
        ] ] } }
      }
    },

    "ECSInstanceAutoScalingGroup": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "Properties": {
        "VPCZoneIdentifier": [ {
          "Fn::Join": [",", [
            { "Ref": "PrivateSubnet" }
          ] ]
        } ],
        "LaunchConfigurationName": { "Ref": "ECSInstanceLaunchConfig" },
        "MinSize": "1",
        "MaxSize": "10",
        "DesiredCapacity": "1",
        "Cooldown": "5",
        "HealthCheckType": "EC2",
        "NotificationConfigurations": [{
          "TopicARN": { "Ref": "EmailNotificationTopic" },
          "NotificationTypes": [
            "autoscaling:EC2_INSTANCE_LAUNCH",
            "autoscaling:EC2_INSTANCE_LAUNCH_ERROR",
            "autoscaling:EC2_INSTANCE_TERMINATE",
            "autoscaling:EC2_INSTANCE_TERMINATE_ERROR"
          ]
        }],
        "Tags": [ { "Key": "Name", "Value": "nfx-depbuilder-ecs-asg", "PropagateAtLaunch": "false" } ]
      },
      "UpdatePolicy": {
        "AutoScalingRollingUpdate": {
          "MaxBatchSize": "1",
          "MinInstancesInService": "1"
        }
      }
    },

    "ECSInstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": {
            "Effect": "Allow",
            "Principal": {
              "Service": [ "ec2.amazonaws.com", "ecs.amazonaws.com" ]
            },
            "Action": [ "sts:AssumeRole" ]
          }
        },
        "Path": "/",
        "Policies": [
          {
            "PolicyName": "ecs-service",
            "PolicyDocument": {
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecs:CreateCluster",
                    "ecs:DeregisterContainerInstance",
                    "ecs:DiscoverPollEndpoint",
                    "ecs:Poll",
                    "ecs:RegisterContainerInstance",
                    "ecs:StartTelemetrySession",
                    "ecs:Submit*",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "*"
                }
              ]
            }
          },
          {
            "PolicyName": "ecr-readonly",
            "PolicyDocument": {
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken",
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:GetRepositoryPolicy",
                    "ecr:DescribeRepositories",
                    "ecr:ListImages",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },

    "ECSInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Path": "/",
        "Roles": [{ "Ref": "ECSInstanceRole" }]
      }
    },

    "ECSTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": {
            "Effect": "Allow",
            "Principal": {
              "Service": [ "ecs-tasks.amazonaws.com" ]
            },
            "Action": [ "sts:AssumeRole" ]
          }
        },
        "Path": "/",
        "Policies": [
          {
            "PolicyName": "ecs-task",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": { "Fn::Join" : ["", [
                    "arn:aws:s3:::",
                    { "Ref" : "JobsBucket" },
                    "/*"
                  ] ] }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:ChangeMessageVisibility"
                  ],
                  "Resource": { "Fn::GetAtt": ["JobQueue", "Arn"] }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecs:RunTask",
                  ],
                  "Condition": {
                    "ArnEquals": {
                      "ecs:cluster": { "Fn::Join": ["", [
                        "arn:aws:ecs:",
                        { "Ref": "AWS::Region" },
                        ":",
                        { "Ref": "AWS::AccountId" },
                        ":cluster/",
                        { "Ref": "ECSCluster" }
                      ] ] }
                    }
                  },
                  "Resource": { "Fn::Join" : ["", [
                    "arn:aws:ecs:",
                    { "Ref": "AWS::Region" },
                    ":",
                    { "Ref": "AWS::AccountId" },
                    ":task-definition/*:*"
                  ] ] }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": { "Fn::GetAtt": ["ECSLogGroup", "Arn"] }
                }
              ]
            }
          }
        ]
      }
    },

    "ALBSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "GroupDescription": "Allow http from public",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": "80",
            "ToPort": "80",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },

    "TrafficFromALBSGIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": { "Fn::GetAtt": ["VPC", "DefaultSecurityGroup"] },
        "IpProtocol": "tcp",
        "FromPort": "32768",
        "ToPort": "65535",
        "SourceSecurityGroupId": { "Ref": "ALBSecurityGroup" }
      },
      "Metadata": {
        "Comment": "Allows access to ephemeral port range on the EC2 instances."
      }
    },

    "ALB": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "nfx-depbuilder-alb",
        "Subnets": [ { "Ref": "PublicSubnet1" }, { "Ref" : "PublicSubnet2" } ],
        "SecurityGroups": [ { "Ref": "ALBSecurityGroup" } ],
        "Tags": [ { "Key": "Name", "Value": "nfx-depbuilder-loadbalancer" } ]
      }
    },

    "ALBTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "HealthCheckIntervalSeconds": 60,
        "UnhealthyThresholdCount": 10,
        "HealthCheckPath": "/",
        "Name": "nfx-depbuilder-tg",
        "Port": 80,
        "Protocol": "HTTP",
        "VpcId": { "Ref": "VPC" }
      }
    },

    "ALBListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "DefaultActions": [{
          "Type": "forward",
          "TargetGroupArn": { "Ref" : "ALBTargetGroup" }
        }],
        "LoadBalancerArn": { "Ref" : "ALB" },
        "Port": "80",
        "Protocol": "HTTP"
      }
    }
  },

  "Outputs": {
    "BuilderDockerRepositoryName": {
      "Description": "Name of repository to push the 'npm install' Docker image to.",
      "Value": { "Ref": "BuilderDockerRepository" }
    },

    "WebDockerRepositoryName": {
      "Description": "Name of repository to push the web server Docker image to.",
      "Value": { "Ref": "WebDockerRepository" }
    }
  }
}
